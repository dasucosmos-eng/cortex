{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".firebaserc",
      "**/node_modules/**",
      "extension/**",
      "db/**",
      "prisma/**",
      "download/**",
      "examples/**",
      "functions/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/api/auth/google", "function": "apiAuthGoogle" },
      { "source": "/api/auth/session", "function": "apiAuthSession" },
      { "source": "/api/auth/extension-token", "function": "apiAuthExtensionToken" },
      { "source": "/api/auth/fingerprint", "function": "apiAuthFingerprint" },
      { "source": "/api/paypal/subscription-status", "function": "apiPaypalSubscriptionStatus" },
      { "source": "/api/paypal/create-subscription", "function": "apiPaypalCreateSubscription" },
      { "source": "/api/paypal/webhook", "function": "apiPaypalWebhook" },
      { "source": "/api/paypal/return", "function": "apiPaypalReturn" },
      { "source": "/api/paypal/cancel", "function": "apiPaypalCancel" },
      { "source": "/api/memories", "function": "apiMemories" },
      { "source": "/api/memories/**", "function": "apiMemories" },
      { "source": "/api/sessions", "function": "apiSessions" },
      { "source": "/api/sessions/**", "function": "apiSessions" },
      { "source": "/api/timeline", "function": "apiTimeline" },
      { "source": "/api/timeline/**", "function": "apiTimeline" },
      { "source": "/api/projects", "function": "apiProjects" },
      { "source": "/api/projects/**", "function": "apiProjects" },
      { "source": "/api/context-capsule", "function": "apiContextCapsule" },
      { "source": "/api/knowledge-graph", "function": "apiKnowledgeGraph" },
      { "source": "/api/knowledge-graph/**", "function": "apiKnowledgeGraph" },
      { "source": "/api/agents", "function": "apiAgents" },
      { "source": "/api/agents/**", "function": "apiAgents" },
      { "source": "/api/search", "function": "apiSearch" },
      { "source": "/api/vault", "function": "apiVault" },
      { "source": "/api/vault/**", "function": "apiVault" },
      { "source": "/api/sync", "function": "apiSync" },
      { "source": "/api/ai/recall", "function": "apiAiRecall" },
      { "source": "/api/data/clear", "function": "apiDataClear" },
      { "source": "/api/settings", "function": "apiSettings" },
      { "source": "/api/memory/process-image", "function": "apiMemoryProcessImage" },
      { "source": "/api/workflow/continuation", "function": "apiWorkflowContinuation" },
      { "source": "/api/import/connectors", "function": "apiImportConnectors" },
      { "source": "/api/import", "function": "apiImport" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg|png|ico|woff2|woff|ttf)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-XSS-Protection", "value": "1; mode=block" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
