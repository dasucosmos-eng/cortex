rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: authenticated users can only access their own docs
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Memories
    match /memories/{memoryId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Sessions
    match /sessions/{sessionId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Timeline
    match /timeline/{eventId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Projects
    match /projects/{projectId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Knowledge nodes
    match /knowledgeNodes/{nodeId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Knowledge edges
    match /knowledgeEdges/{edgeId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Vault items
    match /vault/{itemId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Sync state
    match /syncState/{docId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Subscriptions
    match /subscriptions/{subId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Browser fingerprints (for trial abuse prevention)
    match /fingerprints/{fpId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
  }
}
